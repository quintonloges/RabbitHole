# Development only. Production has independent settings in .local/production/.
# Only the gateway publishes a host port. Do not change the bind to a public interface.
PORT=47832
POSTGRES_PASSWORD=rabbithole-local-only
# OpenAlex may require a free API key. arXiv and RSS do not require one.
# Optional: enables cursor continuation; keyless watches sample only the newest page.
OPENALEX_API_KEY=
# Optional OpenAI-compatible Chat Completions provider. Enable explicitly in Settings.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# Use true only for your consciously configured local model server.
AI_ALLOW_LOCAL=false
# Modern Chat Completions uses max_completion_tokens. Some local servers use max_tokens.
AI_TOKEN_PARAMETER=max_completion_tokens
