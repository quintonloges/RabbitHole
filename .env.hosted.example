# Copy to /etc/rabbithole/hosted.env (chmod 600). Never commit populated settings.
PROJECT_NAME=rabbithole-hosted
PUBLIC_HOST=rabbithole.quintonloges.me
ACME_EMAIL=owner@example.com
POSTGRES_PASSWORD=
STATE_PATH=/srv/rabbithole/state
# Encrypted backups stay on this server; offserver is optional and uses backup.env.
BACKUP_MODE=local
APP_SUBNET=172.30.5.0/24
GATEWAY_IP=172.30.5.2
WEB_IP=172.30.5.3
API_IP=172.30.5.4
HTTP_BIND=0.0.0.0
HTTPS_BIND=0.0.0.0
# Remain paused/noindex until migration rehearsal and launch checks pass.
INGESTION_PAUSED=true
PUBLIC_INDEXING_ENABLED=false
SESSION_HOURS=12
PUBLIC_REQUESTS_PER_MINUTE=120
SEARCH_REQUESTS_PER_MINUTE=30
LOGIN_ATTEMPTS_PER_WINDOW=5
# Copy provider secrets separately. Desktop model endpoints do not migrate automatically.
OPENALEX_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_ALLOW_LOCAL=false
AI_TOKEN_PARAMETER=max_completion_tokens
# For a separate staging/rehearsal config, also change PROJECT_NAME, STATE_PATH,
# APP_SUBNET, GATEWAY_IP, WEB_IP and API_IP. Use the browser's exact SSH-forwarded origin.
# STAGING_ORIGIN=https://rabbithole.quintonloges.me:8443
# STAGING_HTTP_PORT=47833
# STAGING_HTTPS_PORT=47834
