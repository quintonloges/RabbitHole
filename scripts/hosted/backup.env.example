# Install as /etc/rabbithole/backup.env, owner root, mode 600. Shell assignments.
# For DigitalOcean Spaces use its S3 endpoint with a private bucket.
RESTIC_REPOSITORY='s3:https://REGION.digitaloceanspaces.com/PRIVATE-BUCKET/content'
RESTIC_PASSWORD_FILE='/etc/rabbithole/content-backup.password'
RECOVERY_REPOSITORY='s3:https://REGION.digitaloceanspaces.com/PRIVATE-RECOVERY-BUCKET/recovery'
RECOVERY_PASSWORD_FILE='/etc/rabbithole/recovery-backup.password'
AWS_ACCESS_KEY_ID=''
AWS_SECRET_ACCESS_KEY=''
